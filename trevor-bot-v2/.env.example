MESSENGER_PAGE_TOKEN=your_facebook_page_token
MESSENGER_VERIFY_TOKEN=your_verify_token

# LLM Configuration
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_optional

# Database
